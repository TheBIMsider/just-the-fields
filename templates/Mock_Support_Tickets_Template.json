{
  "templateVersion": 1,
  "templateName": "Mock Support Tickets",
  "description": "Template demonstrating support ticket records.",

  "match": {
    "requiredKeys": ["title", "status", "priority"]
  },

  "recordLabel": {
    "fields": [
      { "path": "title", "maxLen": 40 },
      { "path": "priority", "prefix": " (", "suffix": ")" }
    ],
    "fallback": "Ticket {n}"
  },

  "layout": [

    {
      "section": "Ticket",
      "fields": [
        { "path": "title", "label": "Title" },
        { "path": "status", "label": "Status", "format": "badge", "style": "status" },
        { "path": "priority", "label": "Priority", "format": "badge", "style": "status" },
        { "path": "created_date", "label": "Created", "format": "date" }
      ]
    },

    {
      "section": "Customer",
      "fields": [
        { "path": "customer.name", "label": "Company" },
        { "path": "customer.contact", "label": "Contact Email", "format": "email" }
      ]
    },

    {
      "section": "Assignment",
      "fields": [
        { "path": "assigned_to", "label": "Assigned To" }
      ]
    }

  ]
}