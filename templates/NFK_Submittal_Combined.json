{
  "templateVersion": 1,
  "templateName": "NFK Submittal (Combined)",
  "description": "Combined template for Newforma Konekt Submittals (listItem + payloads).",
  "match": {
    "typeField": null,
    "typeValue": null,
    "requiredKeys": ["payloads", "listItem"]
  },
  "recordLabel": {
    "fields": [
      { "path": "listItem.number", "prefix": "", "maxLen": 30 },
      { "path": "listItem.subject", "prefix": " • ", "maxLen": 80 }
    ],
    "fallback": "Submittal {n}"
  },
  "layout": [
    {
      "section": "Overview",
      "fields": [
        { "path": "listItem.number", "label": "Number", "format": "badge" },
        { "path": "listItem.subject", "label": "Subject", "format": "text" },
        { "path": "listItem.status.name", "label": "Status", "format": "badge" },
        { "path": "listItem.isOverdue", "label": "Overdue", "format": "badge" },
        { "path": "listItem.dueDate", "label": "Due", "format": "date" },
        { "path": "listItem.receivedDate", "label": "Received", "format": "date" },
        { "path": "listItem.disciplines", "label": "Disciplines", "format": "chips" },
        { "path": "project.name", "label": "Project", "format": "text" }
      ]
    },
    {
      "section": "Details",
      "fields": [
        { "path": "payloads.submittal.receivedVia.name", "label": "Received via", "format": "badge" },
        { "path": "payloads.submittal.description", "label": "Description", "format": "multiline" },
        { "path": "payloads.submittal.disciplines", "label": "Disciplines", "format": "chips" },
        { "path": "payloads.submittal.specSection.name", "label": "Spec section", "format": "text" },
        { "path": "payloads.submittal.specSection.description", "label": "Spec section description", "format": "text" },
        { "path": "payloads.submittal.keywords", "label": "Keywords", "format": "chips" },
        { "path": "payloads.submittal.version", "label": "Version", "format": "badge" }
      ]
    },
    {
      "section": "Latest Action & Workflow",
      "fields": [
        { "path": "payloads.submittal.mostRecentWorkflowAction.actionType.name", "label": "Action", "format": "badge" },
        { "path": "payloads.submittal.mostRecentWorkflowAction.purpose.name", "label": "Purpose", "format": "text" },
        { "path": "payloads.submittal.mostRecentWorkflowAction.response.name", "label": "Response", "format": "badge" },
        { "path": "payloads.submittal.mostRecentWorkflowAction.remarks", "label": "Remarks", "format": "multiline" },
        { "path": "payloads.submittal.mostRecentWorkflowAction.reviewDueDate", "label": "Review due", "format": "date" },
        { "path": "payloads.submittal.mostRecentWorkflowAction.actionDate", "label": "Action date", "format": "date" },
        { "path": "payloads.submittal.mostRecentWorkflowAction.closedBy.contact.email", "label": "Closed by", "format": "text" },

        { "path": "payloads.submittal.mostRecentWorkflowAction.from.contact", "label": "From", "format": "chips" },
        { "path": "payloads.submittal.mostRecentWorkflowAction.to", "label": "To", "format": "chips" },
        { "path": "payloads.submittal.mostRecentWorkflowAction.cc", "label": "CC", "format": "chips" },

        { "path": "payloads.submittal.workflowActionCount", "label": "Workflow actions", "format": "text" },
        { "path": "payloads.submittal.hasInProgressWorkflowActions", "label": "Has in-progress workflow", "format": "badge" },
        { "path": "payloads.submittal.pendingReviewers", "label": "Pending reviewers", "format": "chips" },
        { "path": "payloads.submittal.reviewers", "label": "Reviewers", "format": "chips" }
      ]
    },
    {
      "section": "Workflow actions (all)",
      "fields": [
        {
          "path": "payloads.workflowactions.items",
          "label": "Workflow actions",
          "fields": [
            { "path": "actionType.name", "label": "Action", "format": "badge" },
            { "path": "actionDate", "label": "Date", "format": "date" },
            { "path": "purpose.name", "label": "Purpose", "format": "text" },
            { "path": "response.name", "label": "Response", "format": "badge" },
            { "path": "remarks", "label": "Remarks", "format": "multiline" },

            { "path": "from.contact", "label": "From", "format": "chips" },
            { "path": "to", "label": "To", "format": "chips" },
            { "path": "cc", "label": "CC", "format": "chips" },

            { "path": "files", "label": "Files", "format": "chips" }
          ]
        }
      ]
    },
    {
      "section": "Files",
      "fields": [
        { "path": "payloads.submittal.fileCount", "label": "File count", "format": "text" },
        { "path": "payloads.files.items", "label": "All files", "format": "chips" }
      ]
    },
	{
	  "section": "History (events)",
	  "fields": [
		{
		  "path": "payloads.events.items",
		  "label": "Events",
		  "fields": [
			{ "path": "type", "label": "Type", "format": "badge" },
			{ "path": "performedOn", "label": "Date", "format": "date" },

			{ "path": "performedBy.fullName", "label": "By", "format": "text" },
			{ "path": "performedBy.email", "label": "By email", "format": "text" },

			{ "path": "data.itemType", "label": "Related type", "format": "badge" },
			{ "path": "data.itemDisplayName", "label": "Related item", "format": "text" },

			{ "path": "data.number", "label": "Submittal #", "format": "text" },
			{ "path": "data.subject", "label": "Subject", "format": "text" },

			{ "path": "data.workflowActionFileName", "label": "File", "format": "text" },
			{ "path": "data.reviewDueDate", "label": "Review due", "format": "date" },

			{ "path": "data.from.fullName", "label": "From", "format": "text" },
			{ "path": "data.from.email", "label": "From email", "format": "text" },
			{ "path": "data.to", "label": "To", "format": "chips" },
			{ "path": "data.cc", "label": "CC", "format": "chips" },

			{ "path": "data.dueDate.previousValue", "label": "Due (was)", "format": "date" },
			{ "path": "data.dueDate.currentValue", "label": "Due (now)", "format": "date" },

			{ "path": "data.isUrgent.previousValue", "label": "Urgent (was)", "format": "badge" },
			{ "path": "data.isUrgent.currentValue", "label": "Urgent (now)", "format": "badge" },

			{ "path": "data.status.previousValue", "label": "Status (was)", "format": "badge" },
			{ "path": "data.status.currentValue", "label": "Status (now)", "format": "badge" }
		  ]
		}
	  ]
	}
  ]
}


