{
  "templateVersion": 1,
  "templateName": "Mock Cars Simple",
  "description": "Sample template for mock car ownership data.",
  "match": {
    "requiredKeys": ["car_make", "car_model", "car_model_year", "car_vin"]
  },

  "recordLabel": {
    "fields": [
      { "path": "car_make", "maxLen": 20 },
      { "path": "car_model", "prefix": " ", "maxLen": 30 },
      { "path": "car_model_year", "prefix": " (", "suffix": ")" }
    ],
    "fallback": "Car {n}"
  },

  "layout": [

    {
      "section": "Vehicle",
      "fields": [
        { "path": "car_make", "label": "Make", "format": "text" },
        { "path": "car_model", "label": "Model", "format": "text" },
        { "path": "car_model_year", "label": "Model Year", "format": "text" },
        { "path": "car_vin", "label": "VIN", "format": "text" }
      ]
    },

    {
      "section": "Owner",
      "fields": [
        { "path": "first_name", "label": "First Name", "format": "text" },
        { "path": "last_name", "label": "Last Name", "format": "text" },
        { "path": "email", "label": "Email", "format": "email" }
      ]
    },

    {
      "section": "Owner Details",
      "fields": [
        { "path": "owner_job", "label": "Occupation", "format": "text" },
        { "path": "owner_city", "label": "City", "format": "text" }
      ]
    }

  ]
}